rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function dadosUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function ehMaster() {
      return request.auth != null && dadosUsuario().role == "master";
    }
    // "Funcionário" = usuário com a funcionalidade de relatórios liberada
    function ehFuncionario() {
      return request.auth != null
        && dadosUsuario().get('funcionalidades', {}).get('relatorios', false) == true;
    }
    function naoAlterou(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }
    // Funcionário só atende clientes atribuídos (lista vazia/ausente = todos)
    function clientePermitido(userId) {
      return !('clientesPermitidos' in dadosUsuario())
        || dadosUsuario().clientesPermitidos.size() == 0
        || userId in dadosUsuario().clientesPermitidos;
    }

    // Empresas (multiempresa): qualquer usuário autenticado pode ler
    // (necessário para resolver o código de convite no cadastro e listar).
    // Só o master cria/edita/exclui empresas (por enquanto).
    match /empresas/{empresaId} {
      allow read: if request.auth != null;
      allow create, update, delete: if ehMaster();
    }

    match /usuarios/{userId} {
      // Dono lê o seu; master e funcionário podem ler para localizar clientes
      allow read: if request.auth != null
                  && (request.auth.uid == userId || ehMaster() || ehFuncionario());

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == "cliente";

      // Master edita qualquer um; o dono edita seus dados exceto campos administrativos
      // (role, funcionalidades, clientesPermitidos, categoria e empresaId).
      allow update: if ehMaster()
                    || (request.auth != null
                        && request.auth.uid == userId
                        && naoAlterou(['role', 'funcionalidades', 'clientesPermitidos', 'categoria', 'empresaId']));

      allow delete: if ehMaster();

      // Painel "Itens para Resolver": funcionário cria; dono lê e atualiza (concluir/foto)
      match /itens_resolver/{item} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId || ehMaster() || ehFuncionario());
        allow create: if ehMaster() || (ehFuncionario() && clientePermitido(userId));
        allow update: if request.auth != null
                      && (request.auth.uid == userId || ehMaster());
        allow delete: if request.auth != null
                      && (request.auth.uid == userId || ehMaster());
      }

      // Registro de relatórios do cliente (somente leitura para ele; funcionário cria)
      match /relatorios/{rel} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId || ehMaster() || ehFuncionario());
        allow create: if ehMaster() || (ehFuncionario() && clientePermitido(userId));
        allow update, delete: if ehMaster();
      }

      // Demais subcoleções do próprio usuário (produtos, compras, vendas, margens...)
      match /{documento=**} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || ehMaster());
      }
    }
  }
}
